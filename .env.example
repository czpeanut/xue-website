# 複製這個檔案為 .env，並修改以下設定後再上線使用
# cp .env.example .env

# 後台管理員登入帳號密碼（務必修改成自己的密碼）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# 用來加密登入 session 的隨機字串，務必修改成自己的一串亂碼
# 可用指令產生： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-this-to-a-random-string

# 伺服器啟動的埠號
PORT=3000
